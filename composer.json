{
    "name": "italix/converters",
    "description": "A pairwise format-conversion contract and a shortest-route driver registry, plus the crop, grid and gap geometry every driver shares — the plumbing of italix/documents and italix/media",
    "type": "library",
    "license": "MPL-2.0",
    "version": "0.7.0",
    "keywords": [
        "conversion",
        "pipeline",
        "routing",
        "pandoc",
        "ffmpeg",
        "options"
    ],
    "homepage": "https://github.com/italix-net/converters",
    "authors": [
        {
            "name": "Italix",
            "email": "info@italix.net"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "italix/testing": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Italix\\Converters\\": ""
        }
    },
    "scripts": {
        "test": [
            "php tests/ConverterSetTest.php",
            "php tests/PipelineTest.php",
            "php tests/CropGeometryTest.php",
            "php tests/AxisLayoutTest.php",
            "php tests/GridGeometryTest.php",
            "php tests/SpansTest.php",
            "php tests/ConversionOptionsTest.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
